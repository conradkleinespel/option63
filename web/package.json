{
  "name": "option63-web",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src-css/app.css -o ./static/css/app.css --minify",
    "dev:css": "tailwindcss -i ./src-css/app.css -o ./static/css/app.css --watch",
    "build:js": "node build-js.mjs",
    "dev:js": "node build-js.mjs --watch",
    "build": "npm run build:css && npm run build:js",
    "dev": "npm run dev:css & npm run dev:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "esbuild": "^0.24.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
